{
  "name": "global-registry-bot",
  "version": "0.1.9",
  "private": true,
  "description": "A configurable GitHub App bot to validate and automate registry-related requests",
  "author": "SAP SE",
  "homepage": "https://github.com/open-resource-discovery/global-registry-bot",
  "keywords": [
    "probot",
    "github",
    "probot-app"
  ],
  "scripts": {
    "prepare": "is-ci || husky",
    "lint": "eslint .",
    "format": "npm run prettier",
    "lint:fix": "npm run prettier && eslint --fix .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.prod.json",
    "prettier:check": "npm run prettier:ci",
    "start": "probot run ./dist/index.js",
    "start:src": "probot run ./src/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "prettier": "prettier --write \"**/*.{js,ts,json,yml,yaml,md}\"",
    "prettier:ci": "prettier --check \"**/*.{js,ts,json,yml,yaml,md}\"",
    "lint:staged": "lint-staged"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-errors": "3.0.0",
    "ajv-formats": "3.0.1",
    "dotenv": "17.4.2",
    "js-yaml": "5.2.3",
    "piscina": "5.3.0",
    "probot": "14.3.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@sap/eslint-config": "0.5.2",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.9.5",
    "babel-jest": "30.4.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.2.0",
    "nock": "14.0.17",
    "prettier": "3.9.6",
    "smee-client": "5.0.0",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "is-ci": "4.1.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "lint-staged": {
    "**/*.{js,ts,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-resource-discovery/global-registry-bot.git"
  },
  "bugs": {
    "url": "https://github.com/open-resource-discovery/global-registry-bot/issues"
  }
}
