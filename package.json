{
  "name": "global-registry-bot",
  "version": "0.1.11-dev.1",
  "private": true,
  "description": "A configurable GitHub App bot to validate and automate registry-related requests",
  "author": "SAP SE",
  "homepage": "https://github.com/open-resource-discovery/global-registry-bot",
  "keywords": ["probot", "github", "probot-app"],
  "scripts": {
    "prepare": "is-ci || husky",
    "lint": "biome lint .",
    "format": "biome format --write . && oxfmt --no-error-on-unmatched-pattern '**/*.{md,yml,yaml,css,scss,html}'",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.prod.json",
    "prettier:check": "npm run format:check",
    "start": "probot run ./dist/index.js",
    "start:src": "probot run ./src/index.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "prettier": "npm run format",
    "prettier:ci": "npm run format:check",
    "lint:staged": "lint-staged",
    "format:check": "biome format . && oxfmt --check --no-error-on-unmatched-pattern '**/*.{md,yml,yaml,css,scss,html}'",
    "check:tooling": "npm run lint && npm run format:check",
    "test:ci": "vitest run --config vitest.config.ts --coverage",
    "coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-errors": "3.0.0",
    "ajv-formats": "3.0.1",
    "dotenv": "18.0.8",
    "js-yaml": "5.5.0",
    "piscina": "5.3.2",
    "probot": "14.3.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.9.9",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nock": "15.0.5",
    "smee-client": "5.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "is-ci": "4.1.0",
    "@biomejs/biome": "2.6.4",
    "oxfmt": "0.75.0",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,html}": ["biome check --write --no-errors-on-unmatched"],
    "*.{md,yml,yaml}": ["oxfmt"]
  },
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-resource-discovery/global-registry-bot.git"
  },
  "bugs": {
    "url": "https://github.com/open-resource-discovery/global-registry-bot/issues"
  }
}
